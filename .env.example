# Copier ce fichier vers .env et remplir avec les vraies valeurs. Ne jamais commiter .env.
# URL racine du site (sans slash final), ex: https://www.jvmag.ch
WP_SITE_URL=

# Utilisateur WordPress associé au mot de passe d'application
WP_USERNAME=

# Réglages > Utilisateurs > Profil > Mots de passe d'application (WordPress admin)
WP_APP_PASSWORD=
